{
  "id": "oom-corroborated-by-metrics",
  "description": "Prometheus shows memory reaching the limit, which should raise confidence in the OOM hypothesis above the exit code alone.",
  "investigation": {
    "context": "prod-east",
    "health": {
      "status": "issues_found"
    },
    "severity": {
      "severity": "Critical"
    },
    "evidence": [
      {
        "id": "k8s.pods:cluster/_cluster/prod-east",
        "kind": "k8s.pods"
      },
      {
        "id": "k8s.pods.logs:cluster/_cluster/prod-east",
        "kind": "k8s.pods.logs"
      },
      {
        "id": "k8s.events:cluster/_cluster/prod-east",
        "kind": "k8s.events"
      },
      {
        "id": "k8s.deployments:cluster/_cluster/prod-east",
        "kind": "k8s.deployments"
      },
      {
        "id": "k8s.network:cluster/_cluster/prod-east",
        "kind": "k8s.network"
      },
      {
        "id": "k8s.nodes:cluster/_cluster/prod-east",
        "kind": "k8s.nodes"
      },
      {
        "id": "k8s.storage:cluster/_cluster/prod-east",
        "kind": "k8s.storage"
      }
    ],
    "evidence_coverage": {
      "completeness": 100,
      "degraded": []
    },
    "pods": {
      "problematic_pods": [
        {
          "name": "web-0",
          "namespace": "prod",
          "status": "OOMKilled"
        }
      ]
    },
    "deep_evidence": {
      "k8s.pod.spec": [
        {
          "id": "k8s.pod.spec:pod/prod/web-0",
          "target": {
            "kind": "Pod",
            "name": "web-0",
            "namespace": "prod"
          },
          "status": "ok",
          "data": {
            "containers": [
              {
                "name": "web",
                "restart_count": 9,
                "limits": {
                  "memory": "512Mi"
                },
                "last_state": {
                  "reason": "OOMKilled",
                  "exit_code": 137
                }
              }
            ]
          }
        }
      ],
      "prometheus.pod.metrics": [
        {
          "id": "prometheus.pod.metrics:pod/prod/web-0",
          "target": {
            "kind": "Pod",
            "name": "web-0",
            "namespace": "prod"
          },
          "status": "ok",
          "data": {
            "memory_peak_percent": 99.2,
            "restarts_in_window": 9
          }
        }
      ]
    }
  },
  "expect": {
    "top_hypothesis": "workload.out_of_memory",
    "signals_present": [
      "metrics.memory_peaked_at_limit:pod/prod/web-0",
      "metrics.restart_rate:pod/prod/web-0"
    ],
    "min_confidence": 80
  }
}
